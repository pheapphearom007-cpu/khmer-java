# Khmer Java Academy Environment Configuration

# Supabase Credentials (Optional for local testing; required for cloud sync across devices)
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Custom Sandboxed Java Runner URL (defaults to Wandbox OpenJDK 21)
# VITE_CUSTOM_JAVA_RUNNER_URL=http://localhost:2000/api/execute
