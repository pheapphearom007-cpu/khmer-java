# Khmer Java Academy Environment Configuration

# -------------------------------------------------------------
# 1. Supabase Credentials (Optional for local guest mode; required for cross-device persistence)
# -------------------------------------------------------------
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------------------------
# 2. Java Sandbox Execution Configuration
# -------------------------------------------------------------
# By default, Khmer Java Academy runs Java code using a secure, isolated
# OpenJDK 21 sandbox API (Wandbox OpenJDK) with UTF-8 Khmer encoding support.

# Set to "true" to simulate or force an unconfigured/disabled execution state.
# When true, the Run button displays a disabled status with a setup guide.
VITE_DISABLE_SANDBOX_EXECUTION=false

# Optional: Custom Self-Hosted Sandboxed Runner Endpoint
# If you run a private Docker container (e.g., Piston or Judge0), specify the URL here:
# Example: http://localhost:2000/api/v2/execute
# VITE_CUSTOM_JAVA_RUNNER_URL=

# -------------------------------------------------------------
# 3. AI Java Tutor Backend Configuration (Kept server-side only)
# -------------------------------------------------------------
# Supports Google Gemini, OpenAI, or custom LLMs.
# When no key is set, the system automatically falls back to the built-in
# offline Khmer Java Knowledge Base without breaking the application.
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_RATE_LIMIT_PER_MINUTE=20
AI_HOURLY_LIMIT=100
